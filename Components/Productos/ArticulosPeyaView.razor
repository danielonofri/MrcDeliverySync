@using MrcDeliverySync.Models
@inject ISnackbar Snackbar
@inject HttpClient HttpClient // O el servicio/repositorio que utilices para las llamadas HTTP de la API

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-2">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h6">Gestión de Catálogo - Artículos PEYA</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadArticulosAsync">
            Actualizar Lista
        </MudButton>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_articulos == null || !_articulos.Any())
    {
        <MudAlert Severity="Severity.Normal" Class="my-2">No se encontraron artículos que comiencen con PEYA.</MudAlert>
    }
    else
    {
        <MudTable Items="_articulos" Hover="true" Striped="true" Dense="true" Elevation="2">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Descripción</MudTh>
                <MudTh>Código de Barras 4</MudTh>
                <MudTh>Sin Stock</MudTh>
                <MudTh Style="text-align:right;">Acción</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código">@context.Codigo</MudTd>
                <MudTd DataLabel="Descripción">@context.Descrip</MudTd>
                <MudTd DataLabel="Código remoto">@context.Codigoerp</MudTd>
                <MudTd DataLabel="Sin Stock">
                    <MudChip T="string" Color="@(context.Sinstock == true ? Color.Error : Color.Success)" Size="Size.Small">
                        @(context.Sinstock == true ? "Sí" : "No")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Acción" Style="text-align:right;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Secondary" 
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ToggleOn"
                               OnClick="@(() => ToggleDisponibilidadAsync(context))">
                        Conmutar Estado
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<ArticuloPeyaDto> _articulos = new();
    private bool _isLoading = false;
    private string _errorMessage = string.Empty;
    private bool _hasLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Se ejecuta exactamente cuando la pestaña se dibuja en el DOM por primera vez
        if (!_hasLoaded && !_isLoading)
        {
            _hasLoaded = true;
            await LoadArticulosAsync();
        }
    }

    private async Task LoadArticulosAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            string endpoint = "api/v1/pos-order-bridge/articulos/peya";
            var response = await HttpClient.GetFromJsonAsync<List<ArticuloPeyaDto>>(endpoint);
            
            _articulos = response ?? new List<ArticuloPeyaDto>();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error de conexión al cargar artículos: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleDisponibilidadAsync(ArticuloPeyaDto articulo)
    {
        try
        {
            bool nuevoEstado = !(articulo.Sinstock ?? false);

            var payload = new
            {
                globalEntityId = "PY_AR",
                items = new[] { articulo.Codigo },
                type = "ITEM",
                isAvailable = nuevoEstado
            };

            var response = await HttpClient.PutAsJsonAsync("api/v1/pos-order-bridge/catalog/items/availability", payload);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Disponibilidad actualizada para {articulo.Codigo}", Severity.Success);
                await LoadArticulosAsync();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al actualizar: {errorContent}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Excepción al conmutar disponibilidad: {ex.Message}", Severity.Error);
        }
    }
}