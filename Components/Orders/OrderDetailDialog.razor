@using MrcDeliverySync.Models
@using MrcDeliverySync.Repositories
@inject IOrderRepository OrderRepository
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Error" />
            <MudText Typo="Typo.h6">
                Pedido #@OrderSummary.ShortCode (@OrderSummary.Operator)
            </MudText>
            <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-auto mr-2">
                @OrderSummary.Status
            </MudChip>
        </div>
    </TitleContent>

    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Error" />
            </div>
        }
        else if (_orderDetail != null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Datos del Cliente</MudText>
                    <MudText Typo="Typo.body2"><b>Nombre:</b> @_orderDetail.CustomerName</MudText>
                    <MudText Typo="Typo.body2"><b>Teléfono:</b> @_orderDetail.CustomerPhone</MudText>
                    <MudText Typo="Typo.body2"><b>Tipo Entrega:</b> @_orderDetail.ExpeditionType</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Resumen de Pago</MudText>
                    <MudText Typo="Typo.body2"><b>Total:</b> $@_orderDetail.TotalAmount.ToString("N2")</MudText>
                    <MudText Typo="Typo.body2"><b>Código:</b> @_orderDetail.Code</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Productos Solicitados</MudText>

                    @if (_orderDetail.Items.Any())
                    {
                        <MudTable Items="_orderDetail.Items" Dense="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh>Cant.</MudTh>
                                <MudTh>Producto</MudTh>
                                <MudTh>Preferencias/Notas</MudTh>
                                <MudTh Style="text-align:right">Precio</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Cant."><b>@context.Quantity x</b></MudTd>
                                <MudTd DataLabel="Producto">@context.ProductName</MudTd>
                                <MudTd DataLabel="Preferencias">@context.Preferencias</MudTd>
                                <MudTd DataLabel="Precio" Style="text-align:right">$@context.UnitPrice.ToString("N2")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">Sin detalle de productos desglosados.</MudAlert>
                    }
                </MudItem>
            </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        @* CANCELAR a la izquierda (visible en RECEIVED, ACCEPTED e INTEGRATED) *@
        @* @if (OrderSummary.Status.Equals("RECEIVED", StringComparison.OrdinalIgnoreCase) ||
             OrderSummary.Status.Equals("ACCEPTED", StringComparison.OrdinalIgnoreCase) ||
             OrderSummary.Status.Equals("INTEGRATED", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="@(() => UpdateStatus("REJECTED"))">
                CANCELAR
            </MudButton>
        } *@

        <MudSpacer />

        @* BOTÓN PRINCIPAL DE ACCIÓN *@
        @if (OrderSummary.Status.Equals("RECEIVED", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => UpdateStatus("ACCEPTED"))">
                ACEPTAR
            </MudButton>
        }
        else if (OrderSummary.Status.Equals("ACCEPTED", StringComparison.OrdinalIgnoreCase) ||
                 OrderSummary.Status.Equals("INTEGRATED", StringComparison.OrdinalIgnoreCase))
        {
            @* Muestra PREPARADO cuando el estado es ACCEPTED o INTEGRATED *@
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => UpdateStatus("PREPARED"))">
                PREPARADO
            </MudButton>
        }
        else if (OrderSummary.Status.Equals("PREPARED", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="@(() => UpdateStatus("DELIVERED"))">
                ENTREGADO
            </MudButton>
        }

        @* BOTÓN CERRAR a la derecha *@
        <MudButton Variant="Variant.Filled" Style="background-color: #2A2E3D; color: white;" OnClick="Cancel">
            CERRAR
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public OrderSummaryDto OrderSummary { get; set; } = null!;

    private OrderDetailDto _orderDetail = null!;
    private bool _isLoading = false; // Ya no hay espera de red

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            // Si la orden ya trae Items (venga de la API o cargada previamente), no consulta a SQL
            if (OrderSummary.Items != null && OrderSummary.Items.Any())
            {
                _orderDetail = new OrderDetailDto
                {
                    Id = OrderSummary.Id,
                    Code = OrderSummary.Code,
                    ShortCode = OrderSummary.ShortCode,
                    CustomerName = OrderSummary.CustomerName,
                    CustomerPhone = OrderSummary.CustomerPhone,
                    ExpeditionType = OrderSummary.ExpeditionType,
                    TotalAmount = OrderSummary.TotalAmount,
                    Status = OrderSummary.Status,
                    Items = OrderSummary.Items
                };
            }
            else
            {
                // Fallback para consultas tradicionales SQL
                _orderDetail = await OrderRepository.GetOrderDetailAsync(OrderSummary.Id, OrderSummary.Operator)
                 ?? new OrderDetailDto
                 {
                     Id = OrderSummary.Id,
                     Code = OrderSummary.Code,
                     ShortCode = OrderSummary.ShortCode,
                     CustomerName = OrderSummary.CustomerName,
                     CustomerPhone = OrderSummary.CustomerPhone,
                     ExpeditionType = OrderSummary.ExpeditionType,
                     TotalAmount = OrderSummary.TotalAmount,
                     Status = OrderSummary.Status,
                     Items = OrderSummary.Items ?? new()
                 };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar detalle: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    private async Task UpdateStatus(string status)
    {
        bool success = false;
        var orderCode = OrderSummary.Code;

        switch (status.ToUpper())
        {
            case "ACCEPTED":
                success = await OrderRepository.AcceptOrderAsync(orderCode);
                break;
            case "REJECTED":
                success = await OrderRepository.RejectOrderAsync(orderCode);
                break;
            case "PREPARED":
                success = await OrderRepository.MarkAsPreparedAsync(orderCode);
                break;
            default:
                success = await OrderRepository.UpdateOrderStatusAsync(OrderSummary.Code, status, OrderSummary.Operator);
                break;
        }

        if (success)
        {
            Snackbar.Add($"Estado actualizado a {status}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add($"No se pudo actualizar el estado a {status}", Severity.Warning);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

