@using MrcDeliverySync.Models
@using MrcDeliverySync.Repositories
@inject IOrderRepository OrderRepository
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Error" />
            <MudText Typo="Typo.h6">
                Pedido #@OrderSummary.ShortCode (@OrderSummary.Operator)
            </MudText>
            <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-auto mr-2">
                @OrderSummary.Status
            </MudChip>
        </div>
    </TitleContent>

    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Error" />
            </div>
        }
        else if (_orderDetail != null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Datos del Cliente</MudText>
                    <MudText Typo="Typo.body2"><b>Nombre:</b> @_orderDetail.CustomerName</MudText>
                    <MudText Typo="Typo.body2"><b>Teléfono:</b> @_orderDetail.CustomerPhone</MudText>
                    <MudText Typo="Typo.body2"><b>Tipo Entrega:</b> @_orderDetail.ExpeditionType</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Resumen de Pago</MudText>
                    <MudText Typo="Typo.body2"><b>Subtotal:</b> $@_orderDetail.SubTotal.ToString("N2")</MudText>
                    @if (_orderDetail.Discount > 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error"><b>Descuento:</b> -$@_orderDetail.Discount.ToString("N2")</MudText>
                    }
                    <MudText Typo="Typo.body2"><b>Total Final:</b> <span class="fw-bold">$@_orderDetail.TotalAmount.ToString("N2")</span></MudText>
                    <MudText Typo="Typo.body2"><b>Código:</b> @_orderDetail.Code</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Productos Solicitados</MudText>

                    @if (_orderDetail.Items.Any())
                    {
                        <MudTable Items="_orderDetail.Items" Dense="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh>Cant.</MudTh>
                                <MudTh>Producto</MudTh>
                                <MudTh>Preferencias/Notas</MudTh>
                                <MudTh Style="text-align:right">Precio</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Cant."><b>@context.Quantity x</b></MudTd>
                                <MudTd DataLabel="Producto">@context.ProductName</MudTd>
                                <MudTd DataLabel="Preferencias">@context.Preferencias</MudTd>
                                <MudTd DataLabel="Precio" Style="text-align:right">$@context.UnitPrice.ToString("N2")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">Sin detalle de productos desglosados.</MudAlert>
                    }
                </MudItem>

                @* Dropdown con valor por defecto TOO_BUSY y sin opción de vaciar (sin Clearable) *@
                @if (OrderSummary.Status.Equals("RECEIVED", StringComparison.OrdinalIgnoreCase))
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudSelect T="string" Label="Motivo de Rechazo" @bind-Value="_rejectionReason" Variant="Variant.Outlined" Dense="true">
                            @foreach (var reason in _rejectionReasons)
                            {
                                <MudSelectItem Value="@reason.Code">@reason.DescriptionEs</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        @* Botón de limpieza con color suave *@
        <MudButton Variant="Variant.Outlined" Style="color: #6c757d; border-color: #6c757d;" OnClick="@(() => UpdateStatus("DESACTIVAR_CANCELADA"))">
            CANCELADO EN OPERADOR
        </MudButton>
        
        @if (OrderSummary.Status.Equals("RECEIVED", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="@(() => UpdateStatus("REJECTED"))">
                RECHAZAR
            </MudButton>
        }

        <MudSpacer />

        @if (OrderSummary.Status.Equals("RECEIVED", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => UpdateStatus("ACCEPTED"))">
                ACEPTAR
            </MudButton>
        }
        else if (OrderSummary.Status.Equals("ACCEPTED", StringComparison.OrdinalIgnoreCase) ||
                 OrderSummary.Status.Equals("INTEGRATED", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => UpdateStatus("PREPARED"))">
                PREPARADO
            </MudButton>
        }
        else if (OrderSummary.Status.Equals("PREPARED", StringComparison.OrdinalIgnoreCase))
        {
            <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="@(() => UpdateStatus("DELIVERED"))">
                ENTREGADO
            </MudButton>
        } 
        else
        {
            <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="@(() => UpdateStatus("FORCEDELIVERED"))">
                FINALIZAR
            </MudButton>
        }

        <MudButton Variant="Variant.Filled" Style="background-color: #2A2E3D; color: white;" OnClick="Cancel">
            CERRAR
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public OrderSummaryDto OrderSummary { get; set; } = null!;

    private OrderDetailDto _orderDetail = null!;
    private bool _isLoading = false;
    
    // Se inicializa por defecto con "TOO_BUSY" para que nunca quede vacío
    private string _rejectionReason = "TOO_BUSY";

    public class RejectionReasonOption
    {
        public string Code { get; set; } = string.Empty;
        public string DescriptionEs { get; set; } = string.Empty;
        public string DescriptionEn { get; set; } = string.Empty;
    }

    private readonly List<RejectionReasonOption> _rejectionReasons = new()
    {
        new() { Code = "ADDRESS_INCOMPLETE_MISSTATED", DescriptionEs = "No se puede entregar debido a información de dirección errónea o incompleta.", DescriptionEn = "Cannot be delivered because of wrong address information." },
        new() { Code = "BAD_WEATHER", DescriptionEs = "No se puede entregar debido a condiciones meteorológicas adversas.", DescriptionEn = "Cannot be delivered because of weather conditions." },
        new() { Code = "BLACKLISTED", DescriptionEs = "El cliente está en la lista negra debido a pedidos falsos o bromas.", DescriptionEn = "Customer is blacklisted due to prank orders." },
        new() { Code = "CARD_READER_NOT_AVAILABLE", DescriptionEs = "El cliente no puede pagar con tarjeta porque el repartidor no lleva datáfono, no funciona o no hay terminal disponible.", DescriptionEn = "Customer cannot pay with card due to courier has no card reader, card reader is not working or no card reader is available." },
        new() { Code = "CLOSED", DescriptionEs = "El local está cerrado y el pedido no se puede procesar.", DescriptionEn = "Vendor is closed and order cannot be fulfilled." },
        new() { Code = "CONTENT_WRONG_MISLEADING", DescriptionEs = "El cliente recibe la comida, nota que no coincide con lo publicado en el sitio web y cancela el pedido.", DescriptionEn = "Customer gets food delivered and realizes that the food does not match what was shown on the website and therefore cancels the order." },
        new() { Code = "FOOD_QUALITY_SPILLAGE", DescriptionEs = "El cliente reporta problemas de calidad de la comida (fría, no comestible, etc.) o derrames durante el transporte.", DescriptionEn = "Customer has an issue with the food quality (cold, inedible, etc) OR order spillage occurred during transport." },
        new() { Code = "FRAUD_PRANK", DescriptionEs = "Pedido fraudulento o falso. Aplicar si existen fuertes indicios de fraude o broma.", DescriptionEn = "Fraudulent order. Should be applied if there are strong indicators for either fraudulent or prank order." },
        new() { Code = "ITEM_UNAVAILABLE", DescriptionEs = "El local no dispone de todos los productos o ingredientes para completar el pedido.", DescriptionEn = "Vendor does not have all items/products available to fulfill the order." },
        new() { Code = "LATE_DELIVERY", DescriptionEs = "El cliente recibió el pedido pero superó excesivamente el tiempo prometido y desea cancelar.", DescriptionEn = "Customer has received the order but (excessively) passed promised delivery time or pickup time and wants to cancel." },
        new() { Code = "MENU_ACCOUNT_SETTINGS", DescriptionEs = "El local tiene problemas con los precios o ítems del menú, o en la configuración de la cuenta.", DescriptionEn = "Vendor has an issue(s) with menu items or prices, or account settings." },
        new() { Code = "MOV_NOT_REACHED", DescriptionEs = "El local rechaza el pedido por no alcanzar el valor mínimo de pedido requerido (MOV).", DescriptionEn = "Vendor will not accept the order as it is below their vendor level Minimum Order Value (MOV)." },
        new() { Code = "NO_COURIER", DescriptionEs = "El local no dispone de repartidores disponibles para realizar la entrega.", DescriptionEn = "Vendor has no courier available to fulfill the order." },
        new() { Code = "NO_PICKER", DescriptionEs = "El local no dispone de personal de preparación (picker) disponible.", DescriptionEn = "Vendor has no picker." },
        new() { Code = "NO_RESPONSE", DescriptionEs = "El local no responde o el sistema POS no aceptó/rechazó el pedido a tiempo.", DescriptionEn = "Vendor is not answering. Triggered if POS plugin is not accepting or rejecting the order in time." },
        new() { Code = "OUTSIDE_DELIVERY_AREA", DescriptionEs = "El local no realiza entregas en la dirección o zona geográfica del cliente.", DescriptionEn = "Vendor does not deliver to the customer's address/area." },
        new() { Code = "TECHNICAL_PROBLEM", DescriptionEs = "El pedido no se puede procesar debido a fallos técnicos del sistema.", DescriptionEn = "Please refrain from using this reason unless necessary. Order cannot be fulfilled due to technical issues." },
        new() { Code = "TEST_ORDER", DescriptionEs = "Pedido realizado con fines de prueba o verificación del flujo de transmisión durante el onboarding.", DescriptionEn = "Order has been placed for test purposes and/or to check order transmission method during onboarding." },
        new() { Code = "TOO_BUSY", DescriptionEs = "El local se encuentra sobrepasado de demanda y no puede atender el pedido.", DescriptionEn = "Vendor is too busy to fulfill the order." },
        new() { Code = "UNABLE_TO_FIND", DescriptionEs = "El repartidor llegó al lugar pero no fue posible ubicar ni contactar al cliente.", DescriptionEn = "Customer cannot be located to complete delivery." },
        new() { Code = "UNABLE_TO_PAY", DescriptionEs = "El cliente no dispone de medios para realizar el pago del pedido.", DescriptionEn = "Customer is not able to pay." },
        new() { Code = "UNPROFESSIONAL_BEHAVIOUR", DescriptionEs = "Comportamiento no profesional registrado durante el proceso de atención o entrega.", DescriptionEn = "Unprofessional behaviour in general from courier or customer interaction." },
        new() { Code = "WILL_NOT_WORK_WITH_PLATFORM", DescriptionEs = "El local no acepta el pedido ya que ha decidido dejar de operar con la plataforma.", DescriptionEn = "Vendor will not accept the order as they no longer wish to work with the platform." },
        new() { Code = "WRONG_ORDER_ITEMS_DELIVERED", DescriptionEs = "El cliente recibió productos equivocados o faltan artículos principales en la entrega.", DescriptionEn = "Customer has received wrong order items or is missing significant item(s)." }
    };

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            if (OrderSummary.Items != null && OrderSummary.Items.Any())
            {
                _orderDetail = new OrderDetailDto
                {
                    Id = OrderSummary.Id,
                    Code = OrderSummary.Code,
                    ShortCode = OrderSummary.ShortCode,
                    CustomerName = OrderSummary.CustomerName,
                    CustomerPhone = OrderSummary.CustomerPhone,
                    ExpeditionType = OrderSummary.ExpeditionType,
                    SubTotal = OrderSummary.SubTotal,
                    Discount = OrderSummary.Discount,
                    TotalAmount = OrderSummary.TotalAmount,
                    Status = OrderSummary.Status,
                    Items = OrderSummary.Items
                };
            }
            else
            {
                _orderDetail = await OrderRepository.GetOrderDetailAsync(OrderSummary.Id, OrderSummary.Operator)
                 ?? new OrderDetailDto
                 {
                     Id = OrderSummary.Id,
                     Code = OrderSummary.Code,
                     ShortCode = OrderSummary.ShortCode,
                     CustomerName = OrderSummary.CustomerName,
                     CustomerPhone = OrderSummary.CustomerPhone,
                     ExpeditionType = OrderSummary.ExpeditionType,
                     SubTotal = OrderSummary.SubTotal,
                     Discount = OrderSummary.Discount,
                     TotalAmount = OrderSummary.TotalAmount,
                     Status = OrderSummary.Status,
                     Items = OrderSummary.Items ?? new()
                 };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar detalle: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateStatus(string status)
    {
        bool success = false;
        var orderCode = OrderSummary.Code;

        switch (status.ToUpper())
        {
            case "ACCEPTED":
                success = await OrderRepository.AcceptOrderAsync(orderCode);
                break;
            case "REJECTED":
                success = await OrderRepository.RejectOrderAsync(orderCode, _rejectionReason);
                break;
            case "PREPARED":
                success = await OrderRepository.MarkAsPreparedAsync(orderCode);
                break;
            case "FORCEDELIVERED":
                success = await OrderRepository.UpdateOrderStatusAsync(OrderSummary.Code, status, OrderSummary.Operator);
                break;
            case "DESACTIVAR_CANCELADA":
                success = await OrderRepository.DesactivarOrdenCancelada(orderCode);
                break;
            default:
                success = await OrderRepository.UpdateOrderStatusAsync(OrderSummary.Code, status, OrderSummary.Operator);
                break;
        }

        if (success)
        {
            Snackbar.Add($"Estado actualizado a {status}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add($"No se pudo actualizar el estado a {status}", Severity.Warning);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}